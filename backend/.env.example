# Application
APP_NAME=CodeAtlas
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-string
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codexa
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
REPOSITORY_STORAGE_PATH=./data/repositories
CHECKPOINT_STORAGE_PATH=./data/checkpoints

# Hardware / ML Execution
DEVICE=auto
MAX_GPU_MEMORY_MB=5000
